<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="250" Margin="8" Padding="16" CornerRadius="18"
        Background="#FFFBF3" BorderBrush="#CAD7C8" BorderThickness="1">
    <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Color="#173B28"/>
    </Border.Effect>
    <Border.Resources>
        <Style TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#173A2B"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF2E6"/>
                    <Setter Property="BorderBrush" Value="#CAD7C8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Border.Resources>
    <StackPanel>
        <TextBlock Text="SPROUT" FontFamily="Segoe UI Semibold" FontSize="17" Foreground="#0C3928"/>
        <TextBlock Text="Your desktop companion" FontSize="11" Foreground="#52645B" Margin="0,3,0,12"/>
        <Button x:Name="BringForwardButton" Content="Bring forward"/>
        <Button x:Name="ReturnToShelfButton" Content="Send to desktop shelf"/>
        <Button x:Name="SettingsButton" Content="Settings"/>
        <Button x:Name="MinimizeButton" Content="Hide to tray"/>
    </StackPanel>
</Border>
