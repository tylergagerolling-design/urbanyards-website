<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Lawnmower Man Settings" Width="520" Height="760" MinHeight="620"
        Background="#FFFDF8" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="The Lawnmower Man" FontFamily="Segoe UI Semibold" FontSize="25" Foreground="#103B2A"/>
            <TextBlock Text="A quiet little desktop companion" FontSize="13" Foreground="#617069" Margin="0,2,0,16"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,10,4">
                <Border BorderBrush="#D9E3DC" BorderThickness="1" CornerRadius="10" Background="#FFFFFF" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Online quote notifications" FontWeight="SemiBold" FontSize="16" Foreground="#103B2A"/>
                        <TextBlock Text="Sign in with your dashboard owner account. Your password is never saved." TextWrapping="Wrap" Foreground="#617069" Margin="0,3,0,10"/>
                        <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBox x:Name="ConnectionEmail" Height="32" Padding="7,5"/>
                        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,9,0,4"/>
                        <PasswordBox x:Name="ConnectionPassword" Height="32" Padding="7,5"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="ConnectUrbanYards" Content="Connect dashboard" Padding="12,7" Margin="0,0,8,8" Background="#1C6A48" Foreground="White" BorderBrush="#1C6A48"/>
                            <Button x:Name="DisconnectUrbanYards" Content="Disconnect" Padding="12,7" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="ConnectionStatus" Text="Not connected" TextWrapping="Wrap" Foreground="#617069" Margin="0,2,0,4"/>
                        <CheckBox x:Name="QuoteNotificationsEnabled" Content="Notify me about new online quote requests" Margin="0,9,0,6"/>
                        <WrapPanel>
                            <Button x:Name="CheckQuotesNow" Content="Check now" Padding="12,7" Margin="0,0,8,8"/>
                            <Button x:Name="TestQuoteNotification" Content="Test notification" Padding="12,7" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="LaunchWithWindows" Content="Launch with Windows" Margin="0,7"/>
                <CheckBox x:Name="AlwaysOnTop" Content="Always on top" Margin="0,7"/>
                <TextBlock Text="Desktop display mode" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <ComboBox x:Name="DisplayMode" Height="32">
                    <ComboBoxItem Content="Floating above application windows" Tag="floating"/>
                    <ComboBoxItem Content="Desktop shelf behind application windows" Tag="shelf"/>
                </ComboBox>
                <CheckBox x:Name="AnimationsEnabled" Content="Enable animations" Margin="0,12,0,7"/>
                <TextBlock Text="Animation speed" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <Slider x:Name="AnimationSpeed" Minimum="0.35" Maximum="2.5" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <WrapPanel Margin="0,18,0,4">
                    <Button x:Name="ResetPosition" Content="Reset pet position" Padding="12,7" Margin="0,0,8,8"/>
                </WrapPanel>
                <Expander Header="Animation preview" Margin="0,12,0,0" IsExpanded="False">
                    <StackPanel Margin="0,10,0,0">
                        <ComboBox x:Name="DebugState" Height="32"/>
                        <Button x:Name="TestAnimation" Content="Run selected animation" Padding="12,7" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelSettings" Content="Cancel" Padding="16,8" Margin="0,0,8,0"/>
            <Button x:Name="SaveSettings" Content="Save settings" Padding="16,8" Background="#1C6A48" Foreground="White" BorderBrush="#1C6A48"/>
        </StackPanel>
    </Grid>
</Window>
