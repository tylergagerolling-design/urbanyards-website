<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Lawnmower Man" Width="460" Height="590" MinWidth="390" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Background="#FFFDF8" WindowStartupLocation="CenterScreen">
    <Border BorderBrush="#173D2B" BorderThickness="1" CornerRadius="18" Background="#FFFDF8">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.28" Color="#173B28"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="ChatHeader" Grid.Row="0" Background="#F2F6EF" Margin="1" Cursor="SizeAll">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="20,16">
                    <TextBlock Text="The Lawnmower Man" FontFamily="Segoe UI Semibold" FontSize="21" Foreground="#103B2A"/>
                    <TextBlock Text="Urban Yards operations assistant" FontFamily="Segoe UI" FontSize="12" Foreground="#5C6C63"/>
                </StackPanel>
                <Button x:Name="ChatClose" Grid.Column="1" Content="×" Width="44" Height="44" Margin="8" FontSize="24"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close"/>
            </Grid>
            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="18" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel">
                    <Border Background="#EEF5EA" CornerRadius="14" Padding="14" Margin="0,0,48,12">
                        <TextBlock Text="I’m The Lawnmower Man. Ask me what needs attention, search your Urban Yards records, or prepare a safe next step." TextWrapping="Wrap" Foreground="#173A2B" FontSize="14"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="16,8,16,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="ChatInput" MinHeight="76" MaxHeight="130" Padding="12" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="14" BorderBrush="#B8C8B7"/>
                <DockPanel Grid.Row="1" Margin="0,9,0,0">
                    <Button x:Name="OpenFullAi" Content="Open full dashboard AI" DockPanel.Dock="Left" Padding="12,8" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#B8C8B7" Foreground="#174B34" Cursor="Hand"/>
                    <Button x:Name="ChatSend" Content="Send" DockPanel.Dock="Right" Padding="18,8"
                            Background="#1C6A48" BorderBrush="#1C6A48" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
